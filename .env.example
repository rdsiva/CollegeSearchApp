# Copy to .env and fill in. Never commit .env (already in .gitignore).

# ─── External APIs ──────────────────────────────────────────
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
YOUTUBE_API_KEY=

# ─── LLM provider switch ────────────────────────────────────
# anthropic (default) | ollama
LLM_PROVIDER=anthropic

# Used only when LLM_PROVIDER=ollama.
# OpenAI-compatible base URL — must include the `/v1` suffix.
# Example local Ollama: http://192.168.40.68:11434/v1
# Example OpenAI:       https://api.openai.com/v1  (then OLLAMA_API_KEY must be a real key)
OLLAMA_URL=http://192.168.40.68:11434/v1
OLLAMA_MODEL=gemma4:e4b
# For Ollama, any non-empty string works. Use a real key only if pointing at OpenAI.
OLLAMA_API_KEY=ollama

# ─── Postgres (for metrics persistence) ─────────────────────
# Reuses the shared sentinelone-portal_s1net postgres. Override only
# if you point this app at a different DB.
DATABASE_URL=postgresql://s1bot:changeme@postgres:5432/collegesearch
